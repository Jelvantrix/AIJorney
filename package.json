{
  "name": "noevix-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:company": "npm run build --workspace=@noevix/app-company",
    "build:chat": "npm run build --workspace=@noevix/app-chat",
    "build:all": "npm run build:company && npm run build:chat",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/company/dist apps/chat/dist server.js",
    "lint": "tsc --noEmit",
    "check:monochrome": "node scripts/check-monochrome.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
