# Noevix Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Inference Backend Selection: 'nim' | 'openai' | 'gemini' | 'mock'
INFERENCE_BACKEND=mock

# Model Tiering
ROUTER_MODEL=meta/llama-3.2-3b-instruct
FAST_MODEL=meta/llama-3.1-8b-instruct
DEEP_MODEL=meta/llama-3.1-70b-instruct

# NVIDIA NIM (Hosted Catalog or Enterprise Self-Hosted)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Generic OpenAI / vLLM / SGLang Endpoint
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=

# Server-Side Gemini API
GEMINI_API_KEY=

# Optional Sandboxed Code Execution
CODE_EXEC_ENABLED=false

# Timeouts & Persistence
ROUTER_TIMEOUT_MS=1500
SPECIALIST_TIMEOUT_MS=8000
STORAGE_DIR=./data
LOG_LEVEL=info
